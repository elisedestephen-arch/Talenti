# TalentAfrique IA - Variables d'environnement

# Clé API OpenAI (obtenez-la sur https://platform.openai.com/api-keys)
OPENAI_API_KEY=votre-cle-api-openai

# Secret JWT pour l'authentification (changez-le en production)
JWT_SECRET=votre-secret-jwt-tres-long-et-aleatoire

# --- WhatsApp (via Meta Cloud API) ---
# 1. Créez un compte WhatsApp Business sur https://business.facebook.com
# 2. Obtenez un Token d'accès depuis https://developers.facebook.com
# 3. Récupérez votre Phone Number ID
WHATSAPP_API_KEY=votre-token-api-whatsapp
WHATSAPP_PHONE_ID=votre-phone-number-id

# --- Stripe (abonnements) ---
# 1. Créez un compte Stripe sur https://dashboard.stripe.com
# 2. Obtenez votre clé secrète (sk_live_xxx ou sk_test_xxx)
STRIPE_SECRET_KEY=votre-cle-secrete-stripe

# 3. Créez un webhook endpoint dans Stripe Dashboard → Webhooks
#    URL: https://votre-domaine.com/api/webhook/stripe
#    Événements: checkout.session.completed, invoice.payment_succeeded,
#                customer.subscription.updated, customer.subscription.deleted
# 4. Copiez le "Signing secret" (whsec_xxx)
STRIPE_WEBHOOK_SECRET=votre-webhook-secret-stripe

# 5. Créez les produits et prix dans Stripe Dashboard → Products
#    Premium Mensuel: 3,99€ (399 centimes)
#    Premium Annuel: 29,99€ (2999 centimes)
#    Pro Mensuel: 7,99€ (799 centimes)
#    Pro Annuel: 69,99€ (6999 centimes)
# 6. Copiez les Price IDs (price_xxx) ci-dessous
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxx_premium_monthly
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_xxx_premium_yearly
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_xxx_pro_yearly

# URL de l'application (utilisée par Stripe pour les redirections)
NEXT_PUBLIC_URL=https://votre-domaine.com
