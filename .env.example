# ==========================================
# TalentAfrique IA — Variables d'environnement
# ==========================================
# Copiez ce fichier en .env et remplissez vos clés
# Pour Railway : ajoutez ces variables dans l'onglet "Variables"

# --- REQUIS : Authentification ---
JWT_SECRET=votre-secret-jwt-tres-long-et-aleatoire
# Générez-le avec : openssl rand -hex 32

# --- REQUIS : API OpenAI ---
OPENAI_API_KEY=votre-cle-api-openai
# Obtenez-la sur https://platform.openai.com/api-keys

# --- OPTIONNEL : URL publique ---
NEXT_PUBLIC_URL=http://localhost:3000
# Sur Railway : https://votre-projet.up.railway.app

# --- OPTIONNEL : WhatsApp (via Meta Cloud API) ---
WHATSAPP_API_KEY=votre-token-api-whatsapp
WHATSAPP_PHONE_ID=votre-phone-number-id

# --- OPTIONNEL : Stripe (abonnements) ---
STRIPE_SECRET_KEY=votre-cle-secrete-stripe
STRIPE_WEBHOOK_SECRET=votre-webhook-secret-stripe
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxx
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_xxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxx

# --- Railway (optionnel, défini automatiquement) ---
# NODE_OPTIONS=--max-old-space-size=1024
# NODE_ENV=production