{
  "build": {
    "command": "npm install && npm run build:railway",
    "public": ".next",
    "builder": "nixpacks",
    "watchPatterns": ["src/**/*", "public/**/*", "package.json"]
  },
  "deploy": {
    "startCommand": "npm run start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}